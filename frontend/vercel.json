{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://commutr-backend.onrender.com/api/:path*"},
    {"source": "/health", "destination": "https://commutr-backend.onrender.com/health"},
    {"source": "/routing/:path*", "destination": "https://valhalla1.openstreetmap.de/:path*"},
    {"source": "/((?!api(?:/|$)|health(?:/|$)|routing(?:/|$)).*)", "destination": "/index.html"}
  ]
}
