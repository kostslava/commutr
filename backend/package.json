{
  "name": "commutr-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/seed.js && node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test:scoring": "tsx scripts/test-scoring.ts",
    "test:rewards": "tsx scripts/test-rewards-clubs.ts",
    "test": "npm run test:scoring && npm run test:rewards && npm run test:chat && npm run test:planner && npm run test:companion && npm run test:evidence && npm run test:safety && npm run test:discover",
    "chat:warm": "tsx scripts/chat-warm.ts",
    "test:chat": "tsx scripts/test-chat.ts",
    "test:planner": "tsx scripts/test-planner.ts",
    "test:real": "tsx scripts/test-real.ts",
    "geocode:warm": "tsx scripts/geocode-warm.ts",
    "agent:setup": "tsx scripts/elevenlabs-agent.ts setup",
    "agent:verify": "tsx scripts/elevenlabs-agent.ts verify",
    "agent:test": "tsx scripts/elevenlabs-agent.ts test",
    "companion:setup": "tsx scripts/companion-setup.ts",
    "test:companion": "tsx scripts/test-companion.ts",
    "test:evidence": "tsx scripts/test-evidence.ts",
    "safety:generate": "tsx scripts/route-safety-generate.ts",
    "test:safety": "tsx scripts/test-route-safety.ts",
    "test:discover": "tsx scripts/test-discover.ts"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "protobufjs": "8.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
