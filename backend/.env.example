# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit keys.

# Gemini API (chat with function calling, voice transcription, fallback speech)
GEMINI_API_KEY=
# Gemini fallback voice (prebuilt voice name)
GEMINI_VOICE=Kore

# ElevenLabs (primary voice). Optional: without these, every reply uses the Gemini voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Characters per day sent to ElevenLabs before switching to the Gemini voice (default 6000)
ELEVENLABS_DAILY_CHAR_BUDGET=

# ElevenLabs live voice agent: shared secret its tools send as the X-Agent-Secret
# header (make one with: openssl rand -hex 32). Empty: every /api/agent/* endpoint
# answers 503. See docs/agent-tools.md.
AGENT_TOOL_SECRET=

# Optional overrides (leave unset normally):
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite      # chat, trip planner
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional existing Muta agent override (otherwise elevenlabs/state.json).
ELEVENLABS_AGENT_ID=

# Enable explicitly labelled no-GPS photo rehearsals on a production demo server.
# Development allows these by default. Never use this as real journey verification.
DEMO_TRIPS_ENABLED=0
