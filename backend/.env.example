# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit keys.

# Gemini API (chat with function calling, voice transcription, fallback speech)
GEMINI_API_KEY=
# Gemini fallback voice (prebuilt voice name)
GEMINI_VOICE=Kore

# ElevenLabs (primary voice). Optional: without these, every reply uses the Gemini voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Characters per day sent to ElevenLabs before switching to the Gemini voice (default 6000)
ELEVENLABS_DAILY_CHAR_BUDGET=
